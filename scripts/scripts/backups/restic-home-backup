#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backup/home/"
# export RESTIC_PASSWORD_FILE="/etc/restic/home.repo.key"

# Export package lists
echo "Exporting package lists..."
mkdir -p $HOME/backups/package-lists
pacman -Qqe > $HOME/backups/package-lists/all-packages.txt
pacman -Qqen > $HOME/backups/package-lists/native-packages.txt
pacman -Qqem > $HOME/backups/package-lists/foreign-packages.txt

# Run the backup
echo "Starting backup at $(date)"

restic backup \
  /home/leo \
  --iexclude="$HOME/android/**" \
  --iexclude="$HOME/AzureToolsForIntelliJ/**" \
  --iexclude="$HOME/bash*" \
  --iexclude="$HOME/cache/**" \
  --iexclude="**/cache/**" \
  --iexclude="**/*.tmp" \
  --iexclude="**/*.log" \
  --iexclude="**/.env" \
  --iexclude="**/.envrc" \
  --iexclude="$HOME/.copilot/**" \
  --iexclude="$HOME/Desktop/**" \
  --iexclude="$HOME/dotfiles/**" \
  --iexclude="$HOME/dotnet/**" \
  --iexclude="$HOME/gitconfig" \
  --iexclude="$HOME/gnopg/**" \
  --iexclude="$HOME/gtkrc-2.0" \
  --iexclude="$HOME/java/**" \
  --iexclude="$HOME/junie/**" \
  --iexclude="$HOME/local/**" \
  --iexclude="$HOME/mozilla/**" \
  --iexclude="$HOME/Music/**" \
  --iexclude="$HOME/nuget/**" \
  --iexclude="$HOME/pki/**" \
  --iexclude="$HOME/profile" \
  --iexclude="$HOME/Public/**" \
  --iexclude="$HOME/pulse-cookie" \
  --iexclude="$HOME/scripts/**" \
  --iexclude="$HOME/steam/**" \
  --iexclude="$HOME/steampath" \
  --iexclude="$HOME/steampid" \
  --iexclude="$HOME/templateengine/**" \
  --iexclude="$HOME/Templates/**" \
  --iexclude="$HOME/thumbnails/**" \
  --iexclude="$HOME/tmux.conf" \
  --iexclude="$HOME/var/**" \
  --iexclude="$HOME/vim*" \
  --iexclude="$HOME/vim/**" \
  --iexclude="**/node_modules/**" \
  --tag "home" \
  --verbose

