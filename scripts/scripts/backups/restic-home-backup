#!/bin/bash

# Set environment variables for repository
# For testing on local SSD:
# export RESTIC_REPOSITORY="/mnt/backup/home/"
# export RESTIC_PASSWORD_FILE="/etc/restic/home.repo.key"

# Export package lists
echo "Exporting package lists..."
mkdir -p ~/backups/package-lists
pacman -Qqe > ~/backups/package-lists/all-packages.txt
pacman -Qqen > ~/backups/package-lists/native-packages.txt
pacman -Qqem > ~/backups/package-lists/foreign-packages.txt

# Run the backup
echo "Starting backup at $(date)"

restic backup \
  /home/leo \
  --exclude="~/.android/**" \
  --exclude="~/.AzureToolsForIntelliJ/**" \
  --exclude="~/.bash*" \
  --exclude="~/.cache/**" \
  --exclude="**/Cache/**" \
  --exclude="**/cache/**" \
  --exclude="**/*.tmp" \
  --exclude="**/*.log" \
  --exclude="**/.env" \
  --exclude="**/.envrc" \
  --exclude="~/.copilot/**" \
  --exclude="~/Desktop/**" \
  --exclude="~/dotfiles/**" \
  --exclude="~/.dotnet/**" \
  --exclude="~/.gitconfig" \
  --exclude="~/.gnopg/**" \
  --exclude="~/.gtkrc-2.0" \
  --exclude="~/.java/**" \
  --exclude="~/.junie/**" \
  --exclude="~/.local/**" \
  --exclude="~/.mozilla/**" \
  --exclude="~/Music/**" \
  --exclude="~/.nuget/**" \
  --exclude="~/.pki/**" \
  --exclude="~/.profile" \
  --exclude="~/Public/**" \
  --exclude="~/.pulse-cookie" \
  --exclude="~/scripts/**" \
  --exclude="~/.steam/**" \
  --exclude="~/.steampath" \
  --exclude="~/.steampid" \
  --exclude="~/.templateengine/**" \
  --exclude="~/Templates/**" \
  --exclude="~/.thumbnails/**" \
  --exclude="~/.tmux.conf" \
  --exclude="~/.var/**" \
  --exclude="~/.vim*" \
  --exclude="~/.vim/**" \
  --exclude="**/node_modules/**" \
  --tag "home" \
  --verbose

