#!/bin/bash
# restic-run: A wrapper script to run restic commands using a specific repository config.

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_help() {
    echo -e "${GREEN}restic-run${NC}: A wrapper for restic with repository configuration."
    echo
    echo -e "Usage: $0 <config-name> <restic-command> [args...]"
    echo
    echo "Available configurations in /etc/restic/:"
    find /etc/restic -maxdepth 1 -name "*.repo.env" -exec basename {} .repo.env \; 2>/dev/null | sort | grep . || echo "  (none found)"
    echo
    echo "Example:"
    echo "  $0 home snapshots"
    echo "  $0 system backup / --exclude-file=/etc/restic/system.exclude"
}

CONFIG_NAME=$1
if [[ -z "$CONFIG_NAME" || "$CONFIG_NAME" == "-h" || "$CONFIG_NAME" == "--help" ]]; then
    show_help
    exit 0
fi
shift

# Check if restic is installed
if ! command -v restic &> /dev/null; then
    echo -e "${RED}Error: restic is not installed.${NC}"
    exit 1
fi

ENV_FILE="/etc/restic/${CONFIG_NAME}.repo.env"

if [ ! -f "$ENV_FILE" ]; then
    echo -e "${RED}Error: Configuration file $ENV_FILE not found.${NC}"
    exit 1
fi

# Load environment variables
# shellcheck source=/dev/null
source "$ENV_FILE"

# Inform user which repository is being used
echo -e "${YELLOW}Using repository config: ${CONFIG_NAME}${NC}"
echo -e "${YELLOW}Repository: ${RESTIC_REPOSITORY}${NC}"
echo

# Run restic
exec restic "$@"
