#  --iexclude="$HOME/profile" \
#  --iexclude="$HOME/Public/**" \
#  --iexclude="$HOME/pulse-cookie" \
#  --iexclude="$HOME/scripts/**" \
#  --iexclude="$HOME/steam/**" \
#  --iexclude="$HOME/steampath" \
#  --iexclude="$HOME/steampid" \
#  --iexclude="$HOME/templateengine/**" \
#  --iexclude="$HOME/Templates/**" \
#  --iexclude="$HOME/thumbnails/**" \
#  --iexclude="$HOME/tmux.conf" \
#  --iexclude="$HOME/var/**" \
#  --iexclude="$HOME/vim*" \
#  --iexclude="$HOME/vim/**" \
#  --iexclude="**/node_modules/**" \

# Maintain backups - Keep 7 daily, 4 weekly, and 12 monthly backups
echo "Pruning old backups..."
restic forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 12 \
  --prune \
  --tag "home"

# Delete environment variables
unset RESTIC_PASSWORD
unset RESTIC_REPOSITORY
unset RESTIC_PASSWORD_FILE

# Check repository integrity
echo "Checking repository integrity..."
restic check

echo "Backup completed at $(date)"
