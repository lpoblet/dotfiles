[Unit]
Description=Restic System Backup Service
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/restic/home.repo.env
ExecStart=/usr/local/bin/restic-system-backup
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=12h
PrivateTmp=true
ProtectSystem=true
ReadWritePaths=/mnt/backups/fedora
StandardOutput=file:/var/log/restic-system-backup.stdout
StandardError=file:/var/log/restic-system-backup.stderr
NotifyAccess=all

[Install]
WantedBy=default.target
