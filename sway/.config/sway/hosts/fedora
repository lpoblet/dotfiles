output eDP-1 {
  # --- Screen resolution and scaling ---
  mode 2880x1800@120Hz scale 1

  # --- Wallpaper image ---
  bg ~/.local/share/wallpapers/Abstract 4K No Logo.png fill
}

# --- Keyboard Settings ---
input type:keyboard {
    xkb_layout "us,us"
    xkb_variant ",intl"
    xkb_numlock enabled
    xkb_options grp:win_space_toggle
    #xkb_options grp:shifts_toggle,caps:escape
    #xkb_options grp:shifts_toggle
}

# --- Touchpad Settings ---
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# --- Waybar ---
exec waybar -c ~/.config/waybar/config-fedora.jsonc -s ~/.config/waybar/style-fedora.css
