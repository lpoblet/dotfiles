# --- Screen resolution and scaling ---
output eDP-1 mode 2880x1800@120Hz scale 1

# --- Wallpaper image ---
output * bg ~/.local/share/wallpapers/Abstract 4K No Logo.png fill

# --- Keyboard Settings ---
#input type:keyboard {
#    xkb_layout "en"
#}

# --- Touchpad Settings ---
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# --- Waybar ---
exec waybar -c ~/.config/waybar/config-fedora.jsonc -s ~/.config/waybar/style-fedora.css
