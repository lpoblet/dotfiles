# --- Screen resolution and scaling ---
output eDP-1 mode 1920x1080@60Hz scale 1

# --- Wallpaper image ---
output * bg ~/Pictures/bg/arch.jpg fill

# --- Keyboard Settings ---
input type:keyboard {
    xkb_layout "latam,us"
    xkb_variant ",intl"
    xkb_numlock enabled
    xkb_options grp:shifts_toggle,caps:escape
}

# --- Touchpad Settings ---
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# --- Waybar ---
exec waybar -c ~/.config/waybar/config-x1c3.jsonc -s ~/.config/waybar/style-x1c3.css
