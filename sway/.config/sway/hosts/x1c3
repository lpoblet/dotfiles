# --- Screen resolution and scaling ---
output eDP-1 mode 1920x1080@60Hz scale 1

# --- Wallpaper image ---
output * bg ~/Pictures/bg/arch.jpg fill

# --- Keyboard Settings ---
input type:keyboard {
    xkb_layout "es"
}

# --- Touchpad Settings ---
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
